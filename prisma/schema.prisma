// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  phone        String?
  vehicles     Vehicle[]
  appointments Appointment[]
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@map("customers")
}

model Vehicle {
  id           String        @id @default(uuid())
  customerId   String        @map("customer_id")
  customer     Customer      @relation(fields: [customerId], references: [id])
  make         String
  model        String
  year         Int
  licensePlate String        @unique @map("license_plate")
  appointments Appointment[]
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@map("vehicles")
}

model Dealership {
  id          String       @id @default(uuid())
  name        String
  address     String?
  serviceBays ServiceBay[]
  technicians Technician[]
  createdAt   DateTime     @default(now()) @map("created_at")

  @@map("dealerships")
}

model ServiceBay {
  id           String        @id @default(uuid())
  dealershipId String        @map("dealership_id")
  dealership   Dealership    @relation(fields: [dealershipId], references: [id])
  name         String
  appointments Appointment[]
  createdAt    DateTime      @default(now()) @map("created_at")

  @@map("service_bays")
}

model Technician {
  id              String        @id @default(uuid())
  dealershipId    String        @map("dealership_id")
  dealership      Dealership    @relation(fields: [dealershipId], references: [id])
  name            String
  email           String        @unique
  specializations String[]
  appointments    Appointment[]
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@map("technicians")
}

model Appointment {
  id           String            @id @default(uuid())
  customerId   String            @map("customer_id")
  customer     Customer          @relation(fields: [customerId], references: [id])
  vehicleId    String            @map("vehicle_id")
  vehicle      Vehicle           @relation(fields: [vehicleId], references: [id])
  technicianId String            @map("technician_id")
  technician   Technician        @relation(fields: [technicianId], references: [id])
  serviceBayId String            @map("service_bay_id")
  serviceBay   ServiceBay        @relation(fields: [serviceBayId], references: [id])
  dealershipId String            @map("dealership_id")
  serviceType  String            @map("service_type")
  startTime    DateTime          @map("start_time")
  endTime      DateTime          @map("end_time")
  status       AppointmentStatus @default(CONFIRMED)
  notes          String?
  idempotencyKey String?           @unique @map("idempotency_key")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  @@index([dealershipId, startTime])
  @@index([serviceBayId, startTime, endTime])
  @@index([technicianId, startTime, endTime])
  @@index([customerId])
  @@map("appointments")
}

enum AppointmentStatus {
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model OutboxEvent {
  id          String       @id @default(uuid())
  eventType   String       @map("event_type")
  payload     Json
  status      OutboxStatus @default(PENDING)
  createdAt   DateTime     @default(now()) @map("created_at")
  deliveredAt DateTime?    @map("delivered_at")

  @@index([status, createdAt])
  @@map("outbox_events")
}

enum OutboxStatus {
  PENDING
  DELIVERED
  FAILED
}

model IdempotencyRecord {
  key          String   @id
  responseBody String   @map("response_body")
  statusCode   Int      @map("status_code")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("idempotency_records")
}
